# Build settings for the static GitHub Pages site (`npm run build:pages`).
# vite.config.js loads env files from this folder only for that build.
# This file is committed on purpose: it holds no secrets, only public build options.

# Organization site: https://serenovatech.github.io/ (repository serenovatech/serenovatech.github.io)
VITE_BASE_PATH=/
VITE_SITE_URL=https://serenovatech.github.io/

# No API server on GitHub Pages
VITE_STATIC_SITE=true

# Real page URLs (/about/, /contact/). Each page gets its own HTML file at build
# time, so refreshing or sharing any page works and search engines can index it.
VITE_ROUTER=browser

# Search engine verification codes (public values, safe to commit).
# Paste only the content="..." value from Google Search Console / Bing Webmaster Tools.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
